<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal configuration. Window-content events are switched on at runtime only while website,
    in-app or Settings-protection rules need them (see FreezrAccessibilityService.applyServiceInfo).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_service_description"
    android:summary="@string/a11y_service_summary"
    android:isAccessibilityTool="false"
    android:notificationTimeout="50" />
